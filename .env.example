# Conta IQOption — FORWARD TEST EM DEMO
IQ_EMAIL=seu_email@gmail.com
IQ_PASSWORD=sua_senha
# PRACTICE = demo (obrigatório p/ forward test). REAL exige CONFIRM_REAL=YES.
IQ_BALANCE_TYPE=PRACTICE
CONFIRM_REAL=

# Ativo — setup validado: H1 viés + RSI M15 zona
IQ_ASSET=BTCUSD
IQ_TIMEFRAME=900
IQ_EXPIRATION=15
IQ_CANDLE_COUNT=120
HTF_TIMEFRAME=3600
HTF_COUNT=100
HTF_EMA=50

# Valor fixo (só se USE_KELLY=0)
IQ_AMOUNT=2.0
# Trava na faixa validada no backtest 1y (payout >= 0.80)
IQ_PAYOUT_MIN=0.80

# Gerenciamento sessão
IQ_STOP_WIN=50.0
IQ_STOP_LOSS=30.0
IQ_MAX_MARTINGALE=0
IQ_MARTINGALE_MULTIPLIER=2.0

# Kelly validado no backtest 1y
USE_KELLY=1
KELLY_PRIOR=0.58
KELLY_FRACTION=0.25
KELLY_MAX_RISK=0.02
KELLY_MIN=1.0
KELLY_LOOKBACK=50
KELLY_PRIOR_WEIGHT=20.0
KELLY_PAYOUT_DEFAULT=0.87

# Estratégia do forward test — NÃO TROCAR durante os 2/3 meses
STRATEGY=rsi_mtf_pullback
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
# 0 = zona (modo do backtest vencedor), 1 = só saída
RSI_REQUIRE_EXIT=0
EMA_FAST=9
EMA_SLOW=21

# Logs
LOG_FILE=bot.log
TRADE_LOG=data/trades_live.csv
